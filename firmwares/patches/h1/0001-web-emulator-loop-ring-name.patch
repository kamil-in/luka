-                    ring.cur_at = ring.to_at;
-                    ring.seq++;
+                if (h && rd32(h) == RING_MAGIC && rd32(h + 8) == loop_ring.len
+                    && crc32_of(h + RING_BODY, loop_ring.len) == rd32(h + 12)) {
+                    loop_ring.cur = loop_ring.to;
+                    loop_ring.cur_at = loop_ring.to_at;
+                    loop_ring.seq++;
                     h1_loop_saved();
                 }
             } else
-                ring.fill[ring.to] = RING_FULL;
-            ring.to = -1;
+                loop_ring.fill[loop_ring.to] = RING_FULL;
