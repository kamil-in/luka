         if (!size || size > RING_MAX)
             return;
         for (i = 0; i < (int)RING_SLOTS; i++) {  /* the slot holding the loop first, then the others */
-            int sl = ring.cur >= 0 ? (ring.cur + i) % (int)RING_SLOTS : i;
