+            loop_ring.crc = crc32_run(loop_ring.crc, page, n);
+            if (plat_data_write(off + RING_BODY + loop_ring.at, page, n) != 0) {
+                loop_ring.at += n;                    /* (a failed write: given up, the save tried anew) */
                 ring_drop();
