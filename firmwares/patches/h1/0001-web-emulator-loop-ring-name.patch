h1 in the browser: fm1-base's web emulator (base/web/emu/emu_web.c) compiles app/app.c into its own
file and keeps its audio output in a global named "ring"; app.c's loop store had the same name, so the
emulator did not compile. The loop store is renamed loop_ring here; nothing else changes.

diff --git a/app/app.c b/app/app.c
index a18b255..0e6a8d1 100644
--- a/app/app.c
+++ b/app/app.c
@@ -269,7 +269,7 @@ static struct {
     uint32_t wait;                       /* frames the loop has been dirty: a save begins a moment after */
     uint32_t gen;                        /* h1_loop_gen when it began: h1_loop is the engine's own memory, so a
                                           * take recorded meanwhile moves its events, and that save is dropped */
-} ring = {-1, 0, 0, {RING_FULL, RING_FULL, RING_FULL, RING_FULL}, -1, 0, 0, 0, 0, 0, 0};
+} loop_ring = {-1, 0, 0, {RING_FULL, RING_FULL, RING_FULL, RING_FULL}, -1, 0, 0, 0, 0, 0, 0};
 #define RING_WAIT 20u                    /* (a third of a second: the save keeps clear of the take's own close) */
 static const uint8_t *ring_src;          /* the blob being written, as h1_loop gave it: it holds until a take
                                           * records again (then the loop is dirty again, and saved anew) */
@@ -334,7 +334,7 @@ static void ring_erase(int slot)
     for (k = 0; k < RING_SECT; k++)
         if (plat_data_erase(ring_off(slot) + k * 4096u) != 0)
             break;
-    ring.fill[slot] = ring_scan(slot, &at, &len, &seq);
+    loop_ring.fill[slot] = ring_scan(slot, &at, &len, &seq);
 }
 
 /* at start, before the sound: the newest whole loop, or 0 */
@@ -342,39 +342,39 @@ static const uint8_t *ring_start(uint32_t *len)
 {
     uint32_t at, n, s, best = 0;
     int i;
-    ring.cur = -1;
-    ring.to = -1;                                /* (a save cut off by the restart is not carried on) */
-    ring.wait = 0;
-    ring.seq = 0;
+    loop_ring.cur = -1;
+    loop_ring.to = -1;                                /* (a save cut off by the restart is not carried on) */
+    loop_ring.wait = 0;
+    loop_ring.seq = 0;
     for (i = 0; i < (int)RING_SLOTS; i++) {
         at = n = s = 0;
-        ring.fill[i] = ring_scan(i, &at, &n, &s);
-        if (n && (ring.cur < 0 || (int32_t)(s - ring.seq) > 0)) {
-            ring.cur = i;
-            ring.cur_at = at;
-            ring.seq = s;
+        loop_ring.fill[i] = ring_scan(i, &at, &n, &s);
+        if (n && (loop_ring.cur < 0 || (int32_t)(s - loop_ring.seq) > 0)) {
+            loop_ring.cur = i;
+            loop_ring.cur_at = at;
+            loop_ring.seq = s;
             best = n;
         }
     }
     for (i = 0; i < (int)RING_SLOTS; i++)        /* every other slot erased now, while it costs nothing */
-        if (i != ring.cur && ring.fill[i] != 0)
+        if (i != loop_ring.cur && loop_ring.fill[i] != 0)
             ring_erase(i);
     *len = best;
-    return ring.cur >= 0 ? plat_data(ring_off(ring.cur) + ring.cur_at) + RING_BODY : 0;
+    return loop_ring.cur >= 0 ? plat_data(ring_off(loop_ring.cur) + loop_ring.cur_at) + RING_BODY : 0;
 }
 
 /* a save given up part-way: its header says so, and how far it got, so the records after it can be found */
 static void ring_drop(void)
 {
     static uint8_t head[16];
-    uint32_t used = RING_BODY + ring_pages(ring.at);
+    uint32_t used = RING_BODY + ring_pages(loop_ring.at);
     wr32(head, RING_DEAD);
     wr32(head + 4, 0);
-    wr32(head + 8, ring.at);
+    wr32(head + 8, loop_ring.at);
     wr32(head + 12, 0);
-    ring.fill[ring.to] = plat_data_write(ring_off(ring.to) + ring.to_at, head, sizeof head) == 0
-        ? ring.to_at + used : RING_FULL;
-    ring.to = -1;
+    loop_ring.fill[loop_ring.to] = plat_data_write(ring_off(loop_ring.to) + loop_ring.to_at, head, sizeof head) == 0
+        ? loop_ring.to_at + used : RING_FULL;
+    loop_ring.to = -1;
 }
 
 static int er_slot = -1;
@@ -384,8 +384,8 @@ static uint32_t er_k;
