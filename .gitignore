# Generated by Cargo
# will have compiled files and executables
/target/
**/*.rs.bk

# MSVC Windows builds of C/C++ libraries
*.pdb

# Project cache & temporary artifacts
/.cache/

# Cloned external firmware repositories (cloned on-demand by build-firmwares.ps1)
/firmwares/*/
!/firmwares/docs/
!/firmwares/dist/

# Operating System files
.DS_Store
Thumbs.db
